{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/shooting-produit-ia",
      "destination": "/shooting-produit-ia.html"
    },
    {
      "source": "/navito",
      "destination": "/navito.html"
    },
    {
      "source": "/questionnaire",
      "destination": "/questionnaire.html"
    },
    {
      "source": "/guide-derush",
      "destination": "/guide-derush.html"
    },
    {
      "source": "/derush",
      "destination": "/guide-derush.html"
    },
    {
      "source": "/vap",
      "destination": "/candidature-vap.html"
    },
    {
      "source": "/mariage",
      "destination": "/mariage/index.html"
    }
  ],
  "headers": [
    {
      "source": "/mariage/p/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}